    <string name="oem_compat_dialog_title">OEM Compatibility Guide</string>
    <string name="oem_compat_dialog_desc_1">Heavily modified ROMs (Xiaomi HyperOS, MIUI, ColorOS, OriginOS, EMUI) implement aggressive background task killers and proprietary permission layers that can terminate floating overlays or sever root IPC bindings during heavy gameplay.</string>
    <string name="oem_compat_dialog_item_overlay_title">1. Pop-up &amp; Overlay Windows</string>
    <string name="oem_compat_dialog_item_overlay_desc">On HyperOS/MIUI, \"Display pop-up windows while running in the background\" must be explicitly allowed in the Security app.</string>
    <string name="oem_compat_dialog_item_autostart_title">2. Autostart &amp; Background Activity</string>
    <string name="oem_compat_dialog_item_autostart_desc">Allowing Autostart prevents OEM memory clean-up services from killing HuntMemory when 3D games consume high memory.</string>
    <string name="oem_compat_dialog_item_battery_title">3. Unrestricted Battery Saver</string>
    <string name="oem_compat_dialog_item_battery_desc">Set app battery saver to \"No restrictions\" so memory searching, freezing, and Lua ESP scripts run uninterrupted.</string>
    <string name="oem_compat_dialog_dismiss">Got it</string>
