    <!-- HMKPM Lockless Mode & Explanation Dialog -->
    <string name="main_screen_hmkpm_lockless">Lockless (RO)</string>
    <string name="main_screen_hmkpm_lockless_tag">Lockless</string>
    <string name="hmkpm_dialog_title">HMKPM Kernel Module</string>
    <string name="hmkpm_dialog_version_label">Module Version</string>
    <string name="hmkpm_dialog_mode_title">Operating Mode</string>
    <string name="hmkpm_dialog_mode_full">Full Access Mode (Read &amp; Write)</string>
    <string name="hmkpm_dialog_mode_full_desc">Kernel mmap_lock was resolved successfully. Direct MMU memory reading, writing, batch operations, and memory freezing are fully enabled.</string>
    <string name="hmkpm_dialog_mode_lockless">Lockless Mode (Read-Only)</string>
    <string name="hmkpm_dialog_mode_lockless_desc">Running without kernel mmap_lock. In-kernel MMU page table traversal and memory scans operate at 100% full speed. Memory writes and freezing are safely disabled by the kernel to protect system integrity.</string>
    <string name="hmkpm_dialog_why_lockless_title">Why are writes disallowed?</string>
    <string name="hmkpm_dialog_why_lockless_desc">In Linux, writing to user memory without acquiring the process mmap_lock risks race conditions, page table corruption, or Use-After-Free if memory is unmapped concurrently. When the mmap_lock offset is unresolved, HMKPM enters Lockless Mode to ensure kernel safety while preserving full read &amp; scan capabilities.</string>
    <string name="hmkpm_dialog_features_title">Kernel Features</string>
    <string name="hmkpm_dialog_feature_read">Direct Memory Read</string>
    <string name="hmkpm_dialog_feature_write">Direct Memory Write</string>
    <string name="hmkpm_dialog_feature_v2p">V2P Address Translation</string>
    <string name="hmkpm_dialog_feature_kernel_scan">In-Kernel MMU Scan</string>
    <string name="hmkpm_dialog_feature_lockless">Lockless Safety Guard</string>
    <string name="hmkpm_dialog_mmap_offset">mmap_lock Offset</string>
    <string name="hmkpm_dialog_status_enabled">Enabled</string>
    <string name="hmkpm_dialog_status_disabled">Disabled</string>
    <string name="hmkpm_dialog_status_active">Active</string>
    <string name="hmkpm_dialog_status_unresolved">Unresolved (-1)</string>
    <string name="lockless_banner_title">HMKPM: Lockless Mode (Read-Only)</string>
    <string name="lockless_banner_desc">Memory writes and freezing are disabled by kernel safety protocol. Memory scanning and reading are fully operational.</string>
    <string name="lockless_mode_write_disabled_title">Write Blocked (Lockless Mode)</string>
    <string name="lockless_mode_write_disabled_desc">HMKPM is running in Lockless Mode. The kernel module does not allow memory writes or freezing without mmap_lock to prevent system instability. Memory searching and reading remain 100% active.</string>
    <string name="lockless_dialog_learn_more">Details</string>
    <string name="hmkpm_dialog_close">Close</string>

