    <!-- Disclaimer Screen -->
    <string name="disclaimer_title">अस्वीकरण</string>
    <string name="disclaimer_text">HuntMemory में आपका स्वागत है।\n\nयह एक मेमोरी पढ़ने और संपादित करने का उपकरण है जो आपके अपने अनुप्रयोगों और प्रक्रियाओं में विकास, डिबगिंग और सीखने के उद्देश्यों के लिए है।\n\nइस एप्लिकेशन का उपयोग अवैध गतिविधियों के लिए करना सख्त वर्जित है, जैसे कि ऑनलाइन गेम में धोखाधड़ी, अन्य एप्लिकेशन का अनधिकृत संशोधन, या कोई अन्य कार्रवाई जो तीसरे पक्ष की सेवा की शर्तों या वर्तमान कानून का उल्लंघन करती है।\n\nजारी रखकर, आप स्वीकार करते हैं और सहमत होते हैं कि आप अपने कार्यों के लिए पूरी तरह जिम्मेदार हैं। इस उपकरण के उपयोग से होने वाले किसी भी दुरुपयोग, क्षति या नकारात्मक परिणामों के लिए डेवलपर जिम्मेदार नहीं हैं।</string>
    <string name="disclaimer_accept_button">स्वीकार करें और जारी रखें</string>
    <string name="disclaimer_scroll_down_hint">अधिक पढ़ने के लिए नीचे स्क्रॉल करें</string>

